# Version control
.git
.github

# Build / env
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/*.egg-info

# Per-package docs + tests are not needed in the image.
**/docs
**/tests

# GPQA Diamond is gated — never bake it into the image (Docker ignores .gitignore).
# The dataset is materialized + mounted at runtime, not shipped in the image.
datasets/gpqa_diamond/

# MATH-500 — keep eval data out of the image too; materialized + mounted at runtime.
datasets/math_500/

# IFBench — keep the third-party test set out of the image; materialized at runtime.
datasets/ifbench/

# The 7 VLM datasets are builder-only (docs/dataset-licenses.md) — never bake
# them into the image; materialized + mounted at runtime.
datasets/mme/
datasets/mmstar/
datasets/ocrbench/
datasets/mmmu_val/
datasets/realworldqa/
datasets/mmbench_en_dev/
datasets/pope/

# ASR datasets (ESB, FLEURS: ~20 GB, SPGISpeech non-commercial, GigaSpeech
# gated) — never bake them into the image; materialized + mounted at runtime.
datasets/asr_*/
